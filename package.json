{
  "name": "dsh-refs2zotero",
  "version": "1.0.0",
  "description": "把当前会话读到的文献写入本机 Zotero。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanboc/dsh-refs2zotero.git"
  },
  "homepage": "https://github.com/yanboc/dsh-refs2zotero#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "zotero",
    "references",
    "citations",
    "bibliography"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "betterSidebar"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "build:client": "node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/build-client.mjs && node --test tests/*.test.js",
    "prepare": "pnpm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.10",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "pdfjs-dist": "^6.4.299"
  }
}
